+  /** Reads HEVC static HDR SEI into CTA-861.3 metadata. */
+  @RequiresNonNull("output")
+  private void updateHdrStaticInfo(byte[] data, int limit) {
+    int pos = 5;
+    boolean changed = false;
+    while (pos < limit) {
+      if (pos == limit - 1 && (data[pos] & 0xFF) == 0x80) {
+        break;
+      }
+      int type = 0;
+      int value;
+      do {
+        value = data[pos++] & 0xFF;
+        type += value;
+      } while (value == 255 && pos < limit);
+      int size = 0;
+      do {
+        if (pos >= limit) {
+          return;
+        }
+        value = data[pos++] & 0xFF;
+        size += value;
+      } while (value == 255 && pos < limit);
+      if (size > limit - pos) {
+        return;
+      }
+      if (type == 137 && size >= 24) {
+        for (int i = 0; i < 16; i += 2) {
+          hdrStaticInfo[1 + i] = data[pos + i + 1];
+          hdrStaticInfo[2 + i] = data[pos + i];
+        }
+        int maxLuminance =
+            ((data[pos + 16] & 255) << 24)
+                | ((data[pos + 17] & 255) << 16)
+                | ((data[pos + 18] & 255) << 8)
+                | (data[pos + 19] & 255);
+        int minLuminance =
+            ((data[pos + 20] & 255) << 24)
+                | ((data[pos + 21] & 255) << 16)
+                | ((data[pos + 22] & 255) << 8)
+                | (data[pos + 23] & 255);
+        maxLuminance /= 10000;
+        hdrStaticInfo[17] = (byte) maxLuminance;
+        hdrStaticInfo[18] = (byte) (maxLuminance >>> 8);
+        hdrStaticInfo[19] = (byte) minLuminance;
+        hdrStaticInfo[20] = (byte) (minLuminance >>> 8);
+        hasMasteringDisplayInfo = true;
+        changed = true;
+      } else if (type == 144 && size >= 4) {
+        hdrStaticInfo[21] = data[pos + 1];
+        hdrStaticInfo[22] = data[pos];
+        hdrStaticInfo[23] = data[pos + 3];
+        hdrStaticInfo[24] = data[pos + 2];
+        hasContentLightInfo = true;
+        changed = true;
+      }
+      pos += size;
+    }
+    if (changed && outputFormat != null) {
+      Format updatedFormat = addHdrStaticInfo(outputFormat);
+      if (updatedFormat != outputFormat) {
+        outputFormat = updatedFormat;
+        output.format(outputFormat);
+      }
+    }
+  }
+
+  private Format addHdrStaticInfo(Format format) {
+    if ((!hasMasteringDisplayInfo && !hasContentLightInfo) || format.colorInfo == null) {
+      return format;
+    }
+    return format
+        .buildUpon()
+        .setColorInfo(
+            format.colorInfo
+                .buildUpon()
+                .setHdrStaticInfo(Arrays.copyOf(hdrStaticInfo, 25))
+                .build())
+        .build();
+  }
