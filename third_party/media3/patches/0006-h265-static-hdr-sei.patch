+  private static int readUnsignedShort(byte[] data, int offset) {
+    return ((data[offset] & 0xFF) << 8) | (data[offset + 1] & 0xFF);
+  }
+
+  private static long readUnsignedInt(byte[] data, int offset) {
+    return ((long) (data[offset] & 0xFF) << 24)
+        | ((long) (data[offset + 1] & 0xFF) << 16)
+        | ((long) (data[offset + 2] & 0xFF) << 8)
+        | (data[offset + 3] & 0xFF);
+  }
+
+  private static boolean setUnsignedShort(byte[] data, int offset, long value) {
+    byte high = (byte) (value >>> 8);
+    byte low = (byte) value;
+    if (data[offset] == high && data[offset + 1] == low) {
+      return false;
+    }
+    data[offset] = high;
+    data[offset + 1] = low;
+    return true;
+  }
+
+  private Format addHdrStaticInfo(Format format) {
+    if ((!hasMasteringDisplayInfo && !hasContentLightInfo) || format.colorInfo == null) {
+      return format;
+    }
+    return format
+        .buildUpon()
+        .setColorInfo(
+            format.colorInfo
+                .buildUpon()
+                .setHdrStaticInfo(Arrays.copyOf(hdrStaticInfo, 25))
+                .build())
+        .build();
+  }
