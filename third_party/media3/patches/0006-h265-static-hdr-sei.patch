+  /** Reads HEVC static HDR SEI into CTA-861.3 metadata. */
+  @RequiresNonNull("output")
+  private void updateHdrStaticInfo(byte[] data, int limit) {
+    int pos = 5;
+    boolean changed = false;
+    while (pos < limit) {
+      if (pos == limit - 1 && (data[pos] & 0xFF) == 0x80) {
+        break;
+      }
+      long type = 0;
+      int value;
+      do {
+        if (pos == limit) {
+          return;
+        }
+        value = data[pos++] & 0xFF;
+        type += value;
+      } while (value == 255);
+      long size = 0;
+      do {
+        if (pos == limit) {
+          return;
+        }
+        value = data[pos++] & 0xFF;
+        size += value;
+      } while (value == 255);
+      if (size > limit - pos) {
+        return;
+      }
+      if (type == 137 && size >= 24) {
+        changed |= setUnsignedShort(hdrStaticInfo, 1, readUnsignedShort(data, pos + 8));
+        changed |= setUnsignedShort(hdrStaticInfo, 3, readUnsignedShort(data, pos + 10));
+        changed |= setUnsignedShort(hdrStaticInfo, 5, readUnsignedShort(data, pos));
+        changed |= setUnsignedShort(hdrStaticInfo, 7, readUnsignedShort(data, pos + 2));
+        changed |= setUnsignedShort(hdrStaticInfo, 9, readUnsignedShort(data, pos + 4));
+        changed |= setUnsignedShort(hdrStaticInfo, 11, readUnsignedShort(data, pos + 6));
+        changed |= setUnsignedShort(hdrStaticInfo, 13, readUnsignedShort(data, pos + 12));
+        changed |= setUnsignedShort(hdrStaticInfo, 15, readUnsignedShort(data, pos + 14));
+        changed |=
+            setUnsignedShort(
+                hdrStaticInfo, 17, Math.min(readUnsignedInt(data, pos + 16), 0xFFFF));
+        changed |=
+            setUnsignedShort(
+                hdrStaticInfo, 19, Math.min(readUnsignedInt(data, pos + 20), 0xFFFF));
+        changed |= !hasMasteringDisplayInfo;
+        hasMasteringDisplayInfo = true;
+      } else if (type == 144 && size >= 4) {
+        changed |= setUnsignedShort(hdrStaticInfo, 21, readUnsignedShort(data, pos));
+        changed |= setUnsignedShort(hdrStaticInfo, 23, readUnsignedShort(data, pos + 2));
+        changed |= !hasContentLightInfo;
+        hasContentLightInfo = true;
+      }
+      pos += (int) size;
+    }
+    if (changed && outputFormat != null) {
+      Format updatedFormat = addHdrStaticInfo(outputFormat);
+      if (updatedFormat != outputFormat) {
+        outputFormat = updatedFormat;
+        output.format(outputFormat);
+      }
