diff --git a/libraries/effect/src/main/res/raw/fragment_shader_transformation_external_yuv_hlg_lut_es3.glsl b/libraries/effect/src/main/res/raw/fragment_shader_transformation_external_yuv_hlg_lut_es3.glsl
