+package androidx.media3.effect;
+
+import static com.google.common.base.Preconditions.checkArgument;
+import static com.google.common.base.Preconditions.checkNotNull;
+
+import android.graphics.Bitmap;
+import androidx.media3.common.util.UnstableApi;
+
+/**
+ * A packed 3D LUT for input-stage HLG-to-SDR conversion.
+ *
+ * <p>The bitmap contains a grid of {@code size} square blue-channel slices. Red advances along a
+ * slice's x axis and green advances along its y axis. LUT output values are SDR electrical RGB.
+ */
+@UnstableApi
+public final class HlgToSdrColorLut {
+  private final Bitmap bitmap;
+  private final int size;
+
+  public HlgToSdrColorLut(Bitmap bitmap, int size) {
+    this.bitmap = checkNotNull(bitmap);
+    this.size = size;
+    checkArgument(!bitmap.isRecycled());
+    checkArgument(size >= 2);
+    checkArgument(bitmap.getWidth() % size == 0);
+    checkArgument(bitmap.getHeight() % size == 0);
+    checkArgument((bitmap.getWidth() / size) * (bitmap.getHeight() / size) >= size);
+  }
+
+  public Bitmap getBitmap() {
+    return bitmap;
+  }
+
+  public int getSize() {
+    return size;
+  }
+}
