+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#extension GL_OES_EGL_image_external : require
+#extension GL_EXT_YUV_target : require
+precision highp float;
+uniform __samplerExternal2DY2YEXT uTexSampler;
+uniform mat3 uYuvToRgbColorTransform;
+uniform sampler2D uColorLut;
+uniform float uColorLutSize;
+uniform vec2 uColorLutTextureSize;
+uniform int uOutputColorTransfer;
+in vec2 vTexSamplingCoord;
+out vec4 outColor;
+
+const int COLOR_TRANSFER_GAMMA_2_2 = 10;
+
+vec3 yuvToRgb(vec3 yuv) {
+  const vec3 yuvOffset = vec3(0.0625, 0.5, 0.5);
+  return clamp(uYuvToRgbColorTransform * (yuv - yuvOffset), 0.0, 1.0);
+}
+
+vec3 sampleColorLut(vec3 color) {
+  float maximum = uColorLutSize - 1.0;
+  vec3 coordinate = clamp(color, 0.0, 1.0) * maximum;
+  float lowerBlue = floor(coordinate.b);
+  float upperBlue = min(lowerBlue + 1.0, maximum);
+  float columns = uColorLutTextureSize.x / uColorLutSize;
+  vec2 lowerSlice = vec2(mod(lowerBlue, columns), floor(lowerBlue / columns));
+  vec2 upperSlice = vec2(mod(upperBlue, columns), floor(upperBlue / columns));
+  vec2 lowerUv =
+      (lowerSlice * uColorLutSize + coordinate.rg + vec2(0.5)) / uColorLutTextureSize;
+  vec2 upperUv =
+      (upperSlice * uColorLutSize + coordinate.rg + vec2(0.5)) / uColorLutTextureSize;
+  return mix(
+      texture(uColorLut, lowerUv).rgb,
+      texture(uColorLut, upperUv).rgb,
+      fract(coordinate.b));
+}
+
+void main() {
+  vec3 mapped = sampleColorLut(yuvToRgb(texture(uTexSampler, vTexSamplingCoord).xyz));
+  if (uOutputColorTransfer != COLOR_TRANSFER_GAMMA_2_2) {
+    mapped = vec3(1.0, 0.0, 0.0);
+  }
+  outColor = vec4(mapped, 1.0);
+}

